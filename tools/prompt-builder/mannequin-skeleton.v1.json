    "hipWidth": 0.24,
    "upperLeg": 0.43,
    "lowerLeg": 0.42,
    "foot": 0.24
  },
  "transformContract": {
    "joint": {
      "position": "[x,y,z] local normalized units",
      "rotationDeg": "[x,y,z] local Euler degrees; fixed order supplied by renderer"
    },
    "root": {
      "position": [0, 0, 0],
      "horizontalTranslationAllowed": false,
      "facingDegRequired": true
    },
    "jointScaleAnimated": false
  },
  "legRoles": ["CONTACT", "SUPPORT", "SWING", "TRAILING"]
}
